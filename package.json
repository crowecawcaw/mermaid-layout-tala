{
  "name": "mermaid-layout-tala",
  "version": "0.1.0",
  "description": "Mermaid flowchart layout using the original TALA engine via WebAssembly",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crowecawcaw/mermaid-layout-tala.git"
  },
  "homepage": "https://github.com/crowecawcaw/mermaid-layout-tala#readme",
  "bugs": {
    "url": "https://github.com/crowecawcaw/mermaid-layout-tala/issues"
  },
  "keywords": [
    "mermaid",
    "mermaid-layout",
    "layout-engine",
    "tala",
    "typescript",
    "flowchart"
  ],
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    }
  },
  "files": [
    "build/src/index.js",
    "build/src/index.d.ts",
    "build/src/render.js",
    "build/src/render.d.ts",
    "build/src/upstream.js",
    "build/src/upstream.d.ts",
    "src",
    "test",
    "LICENSE",
    "UPSTREAM-AUTHORS.md",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --dir test",
    "demo": "vite examples --host 127.0.0.1",
    "build:playground": "vite build examples --base=/mermaid-layout-tala/ --outDir ../dist --emptyOutDir",
    "check:playground": "tsc --noEmit --ignoreConfig --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM examples/demo.ts examples/examples.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "mermaid": ">=12.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "mermaid": "^12.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@d2lang/d2": "0.1.34"
  }
}
